<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xscsiem.hsiem_platform.control.RoleAuditMapper">
  <resultMap id="roleRow" type="com.xscsiem.hsiem_platform.control.ControlPlaneRow$RoleRow">
    <constructor>
      <arg column="name" javaType="java.lang.String" jdbcType="VARCHAR"/>
      <arg column="description" javaType="java.lang.String" jdbcType="VARCHAR"/>
      <arg column="permissions_json" javaType="java.lang.String" jdbcType="VARCHAR"/>
    </constructor>
  </resultMap>
  <resultMap id="auditRow" type="com.xscsiem.hsiem_platform.control.ControlPlaneRow$AuditRow">
    <constructor>
      <arg column="created_at" javaType="java.time.Instant" jdbcType="TIMESTAMP"/>
      <arg column="actor" javaType="java.lang.String" jdbcType="VARCHAR"/>
      <arg column="action" javaType="java.lang.String" jdbcType="VARCHAR"/>
      <arg column="target" javaType="java.lang.String" jdbcType="VARCHAR"/>
    </constructor>
  </resultMap>
  <select id="selectRoles" resultMap="roleRow">
    SELECT name, description, permissions_json FROM roles ORDER BY name
  </select>
  <insert id="insertAudit">
    INSERT INTO audit_logs(actor, action, target) VALUES (#{actor,jdbcType=VARCHAR}, #{action,jdbcType=VARCHAR}, #{target,jdbcType=VARCHAR})
  </insert>
  <select id="selectRecentAuditLogs" resultMap="auditRow">
    SELECT actor, action, target, created_at
    FROM audit_logs ORDER BY created_at DESC, id DESC LIMIT 500
  </select>
</mapper>
