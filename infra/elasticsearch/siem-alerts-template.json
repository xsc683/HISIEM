{
  "index_patterns": ["siem-alerts"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.refresh_interval": "5s",
      "index.codec": "best_compression",
      "index.translog.durability": "async",
      "index.translog.sync_interval": "30s"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "alert.created_at": { "type": "date" },
        "alert.id": { "type": "keyword" },
        "alert.rule_id": { "type": "keyword" },
        "alert.rule_name": { "type": "keyword" },
        "alert.type": { "type": "keyword" },
        "alert.severity": { "type": "keyword" },
        "alert.risk_score": { "type": "integer" },
        "alert.deduplicated_count": { "type": "integer" },
        "alert.description": { "type": "text" },
        "ocsf.class_uid": { "type": "integer" },
        "ocsf.severity_id": { "type": "integer" },
        "ocsf.src_endpoint.ip": { "type": "ip" },
        "rule.tags": { "type": "keyword" },
        "rule.status": { "type": "keyword" },
        "rule.version": { "type": "keyword" },
        "source.ip": { "type": "ip" },
        "user.name": { "type": "keyword" },
        "host.name": { "type": "keyword" },
        "event.action": { "type": "keyword" },
        "event.category": { "type": "keyword" },
        "event.raw": { "type": "match_only_text" },
        "event_count": { "type": "integer" },
        "related_events": { "type": "nested", "dynamic": true }
      }
    }
  }
}
