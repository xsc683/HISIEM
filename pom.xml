<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.xscsiem</groupId>
    <artifactId>hsiem-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>HISIEM platform</name>
    <description>HISIEM control plane modules</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spotless.version>2.43.0</spotless.version>
        <google-java-format.version>1.24.0</google-java-format.version>
        <mybatis-spring-boot.version>4.1.0</mybatis-spring-boot.version>
    </properties>

        <dependencyManagement>
            <dependencies>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter-test</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>co.elastic.clients</groupId>
                <artifactId>elasticsearch-java</artifactId>
                <version>8.14.0</version>
            </dependency>
            <dependency>
                <groupId>com.xscsiem</groupId>
                <artifactId>platform-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xscsiem</groupId>
                <artifactId>iam</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xscsiem</groupId>
                <artifactId>agent-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xscsiem</groupId>
                <artifactId>security-ops</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xscsiem</groupId>
                <artifactId>platform-operations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xscsiem</groupId>
                <artifactId>platform-operations-adapters</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xscsiem</groupId>
                <artifactId>detection-control</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xscsiem</groupId>
                <artifactId>detection-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xscsiem</groupId>
                <artifactId>soar-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xscsiem</groupId>
                <artifactId>soar-adapters</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xscsiem</groupId>
                <artifactId>soar-worker-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xscsiem</groupId>
                <artifactId>platform-migrations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>3.8.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <!-- Keep the initial rollout focused on code changed after the
                         last committed baseline, while enforcing future changes. -->
                    <ratchetFrom>2fdd146</ratchetFrom>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports />
                        <formatAnnotations />
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>modules/platform-contracts</module>
        <module>modules/iam</module>
        <module>modules/agent-adapter</module>
        <module>modules/security-ops</module>
        <module>modules/platform-operations</module>
        <module>modules/platform-operations-adapters</module>
        <module>modules/detection-control</module>
        <module>modules/detection-runtime</module>
        <module>modules/platform-migrations</module>
        <module>modules/soar-core</module>
        <module>modules/soar-adapters</module>
        <module>modules/soar-worker-runtime</module>
        <module>applications/control-api</module>
        <module>applications/detection-controller</module>
        <module>applications/soar-worker</module>
        <module>flink</module>
    </modules>
</project>
